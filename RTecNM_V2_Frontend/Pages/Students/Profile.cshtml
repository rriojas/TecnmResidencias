@page
@{
    ViewData["Title"] = "Perfil de Estudiante - TecNM";
    ViewData["NavActive"] = "students";
}
@section Scripts {
    <script src="~/assets/js/students/profile.js"></script>
}

<div class="tecnm-card">
    <div class="tecnm-card-header">
        <h3 class="tecnm-card-title">Información Académica y de Residencia</h3>
    </div>
    <div class="tecnm-card-body">
        <div class="tecnm-profile-grid">
            <div>
                <span class="tecnm-field-label">Número de Control</span>
                <strong id="displayControlNumber" class="tecnm-field-value tecnm-field-value-emphasis">--</strong>
            </div>
            <div>
                <span class="tecnm-field-label">Nombre Completo</span>
                <strong id="displayName" class="tecnm-field-value">--</strong>
            </div>
            <div>
                <span class="tecnm-field-label">Correo Institucional</span>
                <strong id="displayEmail" class="tecnm-field-value">--</strong>
            </div>
            <div>
                <span class="tecnm-field-label">Promedio General</span>
                <strong id="displayGpa" class="tecnm-field-value tecnm-field-value-emphasis">--</strong>
            </div>
        </div>
    </div>
</div>
