@page
@{
    ViewData["Title"] = "Cronograma de Actividades (26 Semanas) - TecNM";
    ViewData["NavActive"] = "schedule";
}
@section Scripts {
    <script src="~/assets/js/ui.js"></script>
    <script src="~/assets/js/activities/activities.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            initSchedulePage();
        });
    </script>
}

<div id="alertContainer"></div>

<div class="tecnm-actions-bar">
    <div>
        <h1 class="tecnm-page-title">Cronograma de Actividades (26 Semanas)</h1>
        <p class="tecnm-page-subtitle">Seguimiento semanal del plan de trabajo de residencia profesional</p>
    </div>
    <button id="addActivityBtn" type="button" class="tecnm-btn tecnm-btn-primary">+ Nueva Actividad</button>
</div>

<div class="tecnm-card">
    <div class="tecnm-card-header tecnm-d-flex tecnm-justify-between tecnm-align-center">
        <div class="tecnm-d-flex tecnm-align-center tecnm-gap-2 tecnm-flex-wrap">
            <h3 class="tecnm-card-title">Matriz de Avance Semanal</h3>
            <div id="projectSearchContainer" class="tecnm-d-flex tecnm-align-center tecnm-gap-2">
                <button type="button" id="searchProjectBtn" class="tecnm-btn tecnm-btn-secondary tecnm-btn-sm" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                    <span>Buscar Anteproyecto</span>
                </button>
                <span id="selectedProjectBadge" class="tecnm-badge tecnm-badge-info">Cargando anteproyecto...</span>
            </div>
        </div>
        <div class="tecnm-legend">
            <span>Leyenda:</span>
            <span class="tecnm-badge tecnm-badge-approved">Completado</span>
            <span class="tecnm-badge tecnm-badge-pending">En Proceso</span>
            <span class="tecnm-badge tecnm-badge-neutral">Pendiente</span>
        </div>
    </div>
    <div class="tecnm-card-body">
        <div class="tecnm-table-responsive">
            <table class="matrix-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th class="act-title-col">Descripción de la Actividad</th>
                        @for (int w = 1; w <= 26; w++)
                        {
                            <th class="matrix-week-header" title="Semana @w">S@(w)</th>
                        }
                    </tr>
                </thead>
                <tbody id="scheduleTableBody">
                    <tr>
                        <td colspan="28" class="tecnm-table-empty">Cargando cronograma de actividades...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Registrar Nueva Actividad -->
<div id="createActivityModal" class="modal-backdrop">
    <div class="modal-card">
        <div class="tecnm-modal-header">
            <h3 class="tecnm-modal-title">Agregar Nueva Actividad al Cronograma</h3>
            <button type="button" id="closeActivityModalBtn" class="tecnm-modal-close" aria-label="Cerrar">&times;</button>
        </div>

        <form id="activityForm">
            <div class="tecnm-form-group">
                <label for="activityTitleInput" class="tecnm-label">Descripción de la Actividad *</label>
                <input type="text" id="activityTitleInput" class="tecnm-form-control" placeholder="Ej. Análisis de requerimientos y diseño de base de datos..." required>
            </div>

            <div class="tecnm-form-group">
                <label for="plannedWeeksInput" class="tecnm-label">Semanas Estimadas de Duración</label>
                <input type="number" id="plannedWeeksInput" class="tecnm-form-control" value="2" min="1" max="26">
            </div>

            <div class="tecnm-modal-footer">
                <button type="button" id="cancelActivityModalBtn" class="tecnm-btn tecnm-btn-secondary">Cancelar</button>
                <button type="submit" id="submitActivityBtn" class="tecnm-btn tecnm-btn-primary">Guardar Actividad</button>
            </div>
        </form>
    </div>
</div>
