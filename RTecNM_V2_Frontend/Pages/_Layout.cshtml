@{
    var isPublic = ViewData["IsPublic"] as bool? ?? false;
    var navActive = ViewData["NavActive"] as string ?? "";
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Sistema de Residencias Profesionales - TecNM")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/tecnm-theme.css">
    <link rel="stylesheet" href="~/assets/css/main.css">
</head>
<body>
    <div class="tecnm-page-layout">

        <!-- Header Institucional (Spec 08 §4.1: logo izquierda, campus derecha, margen de seguridad 16px) -->
        <header class="tecnm-header">
            <div class="tecnm-container">
                <div class="tecnm-header-inner">
                    <div class="tecnm-brand">
                        <img src="~/assets/images/tecnm-isologo.svg"
                             alt="Tecnológico Nacional de México"
                             class="tecnm-brand-logo">
                        <div class="tecnm-brand-text">
                            <span class="tecnm-brand-title">Tecnológico Nacional de México</span>
                            <span class="tecnm-brand-subtitle">Sistema de Residencias Profesionales</span>
                        </div>
                    </div>
                    <div class="tecnm-header-actions">
                        @if (isPublic)
                        {
                            @RenderSection("HeaderActions", required: true)
                        }
                        else
                        {
                            <div class="user-menu">
                                <button type="button" id="globalSearchTriggerBtn" class="tecnm-btn tecnm-btn-sm tecnm-btn-outline" title="Búsqueda Universal (Ctrl + K)" onclick="window.openGlobalSearch()" data-roles="admin,departmenthead,advisor,vinculacion,director">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                    </svg>
                                    <span>Buscar (Ctrl+K)</span>
                                </button>
                                <div class="user-profile">
                                    <span id="userAvatar" class="user-avatar" aria-hidden="true">··</span>
                                    <span class="user-profile-info">
                                        <span id="userDisplayName" class="user-profile-name">Cargando...</span>
                                        <span id="userRoleDisplay" class="user-profile-role">...</span>
                                    </span>
                                </div>
                                <button type="button" id="logoutBtn" class="user-logout-btn" aria-label="Cerrar Sesión" title="Cerrar Sesión">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Navbar Institucional (Spec 08 §4.2: tab activo azul oscuro + acento dorado) -->
        @if (!isPublic)
        {
            <nav class="tecnm-navbar">
                <div class="tecnm-container">
                    <div class="tecnm-navbar-inner">
                        <button type="button" id="navToggle" class="tecnm-nav-toggle" aria-expanded="false" aria-controls="navbarNav" aria-label="Abrir menú">
                            <svg class="tecnm-nav-toggle-icon tecnm-nav-toggle-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                            </svg>
                            <svg class="tecnm-nav-toggle-icon tecnm-nav-toggle-icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                        </button>
                        <ul id="navbarNav" class="tecnm-navbar-nav">
                            <li class="tecnm-nav-item-standalone"><a class="tecnm-nav-item @(navActive == "dashboard" ? "active" : "")" href="/dashboard" data-nav-icon="home">Panel Principal</a></li>

                            <li class="tecnm-nav-group" data-group="academica">
                                <button type="button" class="tecnm-nav-group-btn" aria-expanded="false" aria-controls="navg-academica">
                                    <span class="tecnm-nav-group-icon" data-nav-group-icon="users" aria-hidden="true"></span>
                                    <span class="tecnm-nav-group-label">Gestión Académica</span>
                                    <span class="tecnm-nav-group-chevron" aria-hidden="true"></span>
                                </button>
                                <ul id="navg-academica" class="tecnm-nav-sublist">
                                    <li data-permission="students.manage" data-roles="admin,departmenthead"><a class="tecnm-nav-item @(navActive == "students" ? "active" : "")" href="/students" data-nav-icon="users">Estudiantes</a></li>
                                    <li data-permission="advisors.manage" data-roles="admin,departmenthead"><a class="tecnm-nav-item @(navActive == "advisors" ? "active" : "")" href="/advisors" data-nav-icon="user-group">Asesores</a></li>
                                    <li data-permission="projects.advisor.assign" data-roles="admin,departmenthead"><a class="tecnm-nav-item @(navActive == "assign_advisor" ? "active" : "")" href="/advisors/assign" data-nav-icon="user-check">Asignación de Asesores</a></li>
                                    <li data-permission="companies.view" data-roles="admin,vinculacion,departmenthead,academic,director,student"><a class="tecnm-nav-item @(navActive == "companies" ? "active" : "")" href="/companies" data-nav-icon="building">Empresas Receptoras</a></li>
                                </ul>
                            </li>

                            <li class="tecnm-nav-group" data-group="residencia">
                                <button type="button" class="tecnm-nav-group-btn" aria-expanded="false" aria-controls="navg-residencia">
                                    <span class="tecnm-nav-group-icon" data-nav-group-icon="document" aria-hidden="true"></span>
                                    <span class="tecnm-nav-group-label">Residencia Profesional</span>
                                    <span class="tecnm-nav-group-chevron" aria-hidden="true"></span>
                                </button>
                                <ul id="navg-residencia" class="tecnm-nav-sublist">
                                    <li data-permission="projects.proposals"><a class="tecnm-nav-item @(navActive == "proposal" ? "active" : "")" href="/projects/proposal" data-nav-icon="pencil">Solicitud de Anteproyecto</a></li>
                                    <li data-permission="projects.review" data-roles="admin,vinculacion,departmenthead,advisor"><a class="tecnm-nav-item @(navActive == "review" ? "active" : "")" href="/projects/review" data-nav-icon="clipboard">Dictamen de División</a></li>
                                    <li data-permission="activities.schedule"><a class="tecnm-nav-item @(navActive == "schedule" ? "active" : "")" href="/activities/schedule" data-nav-icon="calendar">Cronograma de Actividades</a></li>
                                </ul>
                            </li>

                            <li class="tecnm-nav-group" data-group="evaluacion">
                                <button type="button" class="tecnm-nav-group-btn" aria-expanded="false" aria-controls="navg-evaluacion">
                                    <span class="tecnm-nav-group-icon" data-nav-group-icon="book" aria-hidden="true"></span>
                                    <span class="tecnm-nav-group-label">Evaluación y Seguimiento</span>
                                    <span class="tecnm-nav-group-chevron" aria-hidden="true"></span>
                                </button>
                                <ul id="navg-evaluacion" class="tecnm-nav-sublist">
                                    <li data-permission="evaluations.advisories"><a class="tecnm-nav-item @(navActive == "evaluations" ? "active" : "")" href="/evaluations" data-nav-icon="book">Bitácora de Asesorías</a></li>
                                    <li data-permission="evaluations.grading" data-roles="admin,departmenthead,advisor"><a class="tecnm-nav-item @(navActive == "grading" ? "active" : "")" href="/evaluations/grading" data-nav-icon="star">Evaluaciones</a></li>
                                    <li data-permission="documents.digital"><a class="tecnm-nav-item @(navActive == "documents" ? "active" : "")" href="/documents" data-nav-icon="folder">Expediente Digital</a></li>
                                </ul>
                            </li>

                            <li class="tecnm-nav-group" data-group="administracion" data-roles="admin,departmenthead,director">
                                <button type="button" class="tecnm-nav-group-btn" aria-expanded="false" aria-controls="navg-administracion">
                                    <span class="tecnm-nav-group-icon" data-nav-group-icon="chart" aria-hidden="true"></span>
                                    <span class="tecnm-nav-group-label">Administración</span>
                                    <span class="tecnm-nav-group-chevron" aria-hidden="true"></span>
                                </button>
                                <ul id="navg-administracion" class="tecnm-nav-sublist">
                                    <li data-permission="admin.reports" data-roles="admin,departmenthead,director"><a class="tecnm-nav-item @(navActive == "reports" ? "active" : "")" href="/admin/reports" data-nav-icon="chart">Reportes y Liberación</a></li>
                                    <li data-permission="admin.roles" data-roles="admin,departmenthead,director"><a class="tecnm-nav-item @(navActive == "roles" ? "active" : "")" href="/admin/roles" data-nav-icon="user-group">Usuarios y Roles</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        }

        <!-- Contenido Principal -->
        @if (isPublic)
        {
            <main class="tecnm-public-main">
                @RenderBody()
            </main>
        }
        else
        {
            <main class="tecnm-main-content">
                <div class="tecnm-container">
                    @RenderBody()
                </div>
            </main>
        }

        <!-- Footer -->
        <footer class="tecnm-footer">
            <div class="tecnm-container">
                <p>TecNM - Campus Monclova © 2026 - Todos los derechos reservados</p>
            </div>
        </footer>
    </div>

    @if (!isPublic)
    {
        @await Html.PartialAsync("Shared/_GlobalSearchModal")
        <script src="~/assets/js/layout.js"></script>
        <script src="~/assets/js/global-search.js"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
