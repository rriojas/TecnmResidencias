@page
@{
    ViewData["Title"] = "Gestión de Estudiantes Residentes - TecNM";
    ViewData["NavActive"] = "students";
}
@section Scripts {
    <script src="~/assets/js/ui.js"></script>
    <script src="~/assets/js/students/students.js"></script>
}

<div class="tecnm-actions-bar">
    <div>
        <h1 class="tecnm-page-title">Gestión de Estudiantes Residentes</h1>
        <p class="tecnm-page-subtitle">Catálogo de estudiantes y consulta de expedientes</p>
    </div>
    <div class="tecnm-page-actions">
        <button type="button" class="tecnm-btn tecnm-btn-secondary" onclick="window.openGlobalSearch({ initialSource: 'STUDENTS', onSelect: (row) => window.displaySingleStudent && window.displaySingleStudent(row) })">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <span>Abrir búsqueda</span>
        </button>
        <span class="tecnm-page-actions-divider" aria-hidden="true"></span>
        <button id="openCreateModalBtn" class="tecnm-btn tecnm-btn-primary">Registrar Nuevo Estudiante</button>
    </div>
</div>

<div id="alertContainer"></div>

<div class="tecnm-card">
    <div class="tecnm-card-header">
        <h3 class="tecnm-card-title">Directorio de Estudiantes</h3>
    </div>
    <div class="tecnm-card-toolbar">

        <div class="tecnm-toolbar-actions">
            <label class="tecnm-switch-label">
                <span class="tecnm-switch">
                    <input type="checkbox" id="studentsIncludeInactiveToggle">
                    <span class="tecnm-switch-slider"></span>
                </span>
                Mostrar inactivos
            </label>
            <button type="button" id="exportStudentsBtn" class="tecnm-btn tecnm-btn-secondary tecnm-btn-sm">Exportar PDF</button>
        </div>
    </div>
    <div class="tecnm-card-body">
        <div class="tecnm-table-responsive">
            <table class="tecnm-table" id="studentsTable">
                <thead>
                    <tr>
                        <th data-sort="ControlNumber">No. Control</th>
                        <th data-sort="LastName">Nombre Completo</th>
                        <th>Correo Institucional</th>
                        <th data-sort="Gpa">Promedio</th>
                        <th>Estado</th>
                        <th class="tecnm-text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="studentsTableBody">
                    <tr>
                        <td colspan="6" class="tecnm-table-empty">Cargando estudiantes...</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="studentsPagination"></div>
    </div>
</div>

<div id="studentModal" class="modal-backdrop">
    <div class="modal-card">
        <h3 id="modalTitle" class="tecnm-modal-title">Registrar Nuevo Estudiante</h3>
        <form id="studentForm">
            <input type="hidden" id="studentId" value="">

            <div id="studentFormAlert" class="tecnm-alert tecnm-alert-danger tecnm-hidden"></div>

            <div class="tecnm-form-grid">
                <div class="tecnm-form-group">
                    <label for="controlNumber" class="tecnm-label">Número de Control</label>
                    <input type="text" id="controlNumber" class="tecnm-form-control" placeholder="20680123" required>
                </div>

                <div class="tecnm-form-group">
                    <label for="firstName" class="tecnm-label">Nombre(s)</label>
                    <input type="text" id="firstName" class="tecnm-form-control" placeholder="Juan" required>
                </div>

                <div class="tecnm-form-group">
                    <label for="lastName" class="tecnm-label">Apellido Paterno / Materno</label>
                    <input type="text" id="lastName" class="tecnm-form-control" placeholder="Pérez López" required>
                </div>

                <div class="tecnm-form-group">
                    <label for="email" class="tecnm-label">Correo institucional</label>
                    <input type="email" id="email" class="tecnm-form-control" placeholder="20680123@monclova.tecnm.mx" required>
                </div>

                <div class="tecnm-form-group">
                    <label for="careerId" class="tecnm-label">Carrera</label>
                    <select id="careerId" class="tecnm-form-control" required>
                        <option value="1">Ingeniería Informática</option>
                        <option value="2">Ingeniería Industrial</option>
                        <option value="3">Ingeniería Mecatrónica</option>
                        <option value="4">Ingeniería en Sistemas Computacionales</option>
                    </select>
                </div>

                <div class="tecnm-form-group">
                    <label for="gpa" class="tecnm-label">Promedio General</label>
                    <input type="number" step="0.1" min="0" max="100" id="gpa" class="tecnm-form-control" placeholder="92.5" required>
                </div>
            </div>

            <div class="tecnm-form-actions">
                <button type="button" id="closeModalBtn" class="tecnm-btn tecnm-btn-secondary">Cancelar</button>
                <button type="submit" class="tecnm-btn tecnm-btn-primary">Guardar Estudiante</button>
            </div>
        </form>
    </div>
</div>
