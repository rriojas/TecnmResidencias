@page
@{
    ViewData["Title"] = "Captura de Calificaciones - TecNM";
    ViewData["NavActive"] = "grading";
}
@section Scripts {
    <script src="~/assets/js/ui.js"></script>
    <script src="~/assets/js/evaluations/evaluations.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            initGradingPage();
        });
    </script>
}

<div id="alertContainer"></div>

<div class="tecnm-actions-bar">
    <div>
        <h1 class="tecnm-page-title">Evaluación y Calificaciones del Residente</h1>
        <p class="tecnm-page-subtitle">Captura de evaluaciones parciales y reporte final</p>
    </div>
    <button type="button" id="openGradingModalBtn" class="tecnm-btn tecnm-btn-primary">+ Registrar Calificación</button>
</div>

<div class="tecnm-card">
    <div class="tecnm-card-header">
        <h3 class="tecnm-card-title">Calificaciones Registradas en Base de Datos</h3>
    </div>
    <div class="tecnm-card-toolbar">
        <div id="projectSearchContainer" class="tecnm-d-flex tecnm-align-center tecnm-gap-2">
            <button type="button" id="searchProjectBtn" class="tecnm-btn tecnm-btn-secondary tecnm-btn-sm" style="display: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <span>Buscar Anteproyecto</span>
            </button>
            <span id="selectedProjectBadge" class="tecnm-badge tecnm-badge-info">Cargando anteproyecto...</span>
        </div>
    </div>
    <div class="tecnm-card-body">
        <div class="tecnm-table-responsive">
            <table class="tecnm-table tecnm-table-striped">
                <thead>
                    <tr>
                        <th>Período Evaluado</th>
                        <th>Calificación</th>
                        <th>Estudiante</th>
                        <th>Observaciones</th>
                        <th>Fecha de Registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="evaluationsTableBody">
                    <tr>
                        <td colspan="6" class="tecnm-table-empty">Cargando evaluaciones...</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="evaluationsPagination"></div>
    </div>
</div>

<!-- Modal Captura de Calificación -->
<div id="createGradingModal" class="modal-backdrop">
    <div class="modal-card">
        <div class="tecnm-modal-header">
            <h3 class="tecnm-modal-title">Registrar Calificación de Residencia</h3>
            <button type="button" id="closeGradingModalBtn" class="tecnm-modal-close" aria-label="Cerrar">&times;</button>
        </div>

        <form id="gradingForm">
            <div class="tecnm-form-group">
                <label for="modalGradeProjectId" class="tecnm-label">Proyecto Seleccionado *</label>
                <div id="gradeProjectAutocompleteWrapper">
                    <input type="hidden" id="modalGradeProjectId" required>
                </div>
            </div>

            <div class="tecnm-form-group" id="evaluatorFormGroup">
                <label for="evaluatorId" class="tecnm-label">Evaluador / Asesor *</label>
                <div id="evaluatorAutocompleteWrapper">
                    <input type="hidden" id="evaluatorId" required>
                </div>
            </div>

            <div class="tecnm-form-group">
                <label for="evaluationPeriod" class="tecnm-label">Período a Evaluar *</label>
                <select id="evaluationPeriod" class="tecnm-form-control" required>
                    <option value="partial_1">Primer Reporte Parcial</option>
                    <option value="partial_2">Segundo Reporte Parcial</option>
                    <option value="final">Reporte Final</option>
                </select>
            </div>

            <div class="tecnm-form-group">
                <label for="score" class="tecnm-label">Calificación (0 - 100) *</label>
                <input type="number" id="score" class="tecnm-form-control" min="0" max="100" step="0.01" placeholder="Ej. 95.00" required>
            </div>

            <div class="tecnm-form-group">
                <label for="feedback" class="tecnm-label">Observaciones y Retroalimentación</label>
                <textarea id="feedback" class="tecnm-form-control" rows="3" placeholder="Ingrese comentarios y observaciones sobre el reporte evaluado..."></textarea>
            </div>

            <div class="tecnm-modal-footer">
                <button type="button" id="cancelGradingModalBtn" class="tecnm-btn tecnm-btn-secondary">Cancelar</button>
                <button type="submit" class="tecnm-btn tecnm-btn-primary">Guardar Calificación</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Calificación -->
<div id="editGradingModal" class="modal-backdrop">
    <div class="modal-card">
        <div class="tecnm-modal-header">
            <h3 class="tecnm-modal-title">Editar Calificación</h3>
            <button type="button" id="closeEditGradingModalBtn" class="tecnm-modal-close" aria-label="Cerrar">&times;</button>
        </div>

        <form id="editGradingForm">
            <input type="hidden" id="editEvaluationId">
            <input type="hidden" id="editEvaluationProjectId">
            <input type="hidden" id="editEvaluationPeriodHidden">

            <div class="tecnm-form-group">
                <label class="tecnm-label">Período Evaluado</label>
                <input type="text" id="editEvaluationPeriodDisplay" class="tecnm-form-control" disabled>
            </div>

            <div class="tecnm-form-group" id="editEvaluatorFormGroup">
                <label for="editEvaluatorId" class="tecnm-label">Evaluador / Asesor *</label>
                <div id="editEvaluatorAutocompleteWrapper">
                    <input type="hidden" id="editEvaluatorId" required>
                </div>
            </div>

            <div class="tecnm-form-group">
                <label for="editScore" class="tecnm-label">Calificación (0 - 100) *</label>
                <input type="number" id="editScore" class="tecnm-form-control" min="0" max="100" step="0.01" required>
            </div>

            <div class="tecnm-form-group">
                <label for="editFeedback" class="tecnm-label">Observaciones y Retroalimentación</label>
                <textarea id="editFeedback" class="tecnm-form-control" rows="3"></textarea>
            </div>

            <div class="tecnm-modal-footer">
                <button type="button" id="cancelEditGradingModalBtn" class="tecnm-btn tecnm-btn-secondary">Cancelar</button>
                <button type="submit" class="tecnm-btn tecnm-btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>
