# ==============================================================================
# Environment Configuration Template - TecNM Professional Residency System
# Tech Stack: C# .NET 10 | EF Core 10 | PostgreSQL 18 | Ubuntu 24.04 LTS
# ==============================================================================

# Application Environment & Server Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:5000
APP_URL=http://localhost

# Database Configuration (PostgreSQL 18)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=residency_v2
DB_USERNAME=residency_user
DB_PASSWORD=SecurePassword2026!
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=residency_v2;Username=residency_user;Password=SecurePassword2026!"

# Security Settings (JWT Authentication)
JWT_SECRET=super_secret_jwt_key_min_32_chars_long_2026_tecnm
JWT_ISSUER=TecNM_Residency_System
JWT_AUDIENCE=TecNM_Residency_Users
JWT_EXPIRATION_MINUTES=1440

# Storage and Upload Limits
UPLOAD_STORAGE_PATH=/var/www/sistemaresidencia/storage/uploads
MAX_UPLOAD_SIZE_MB=15

# Logging & Monitoring
LOG_LEVEL=Information
LOG_PATH=/var/www/sistemaresidencia/storage/logs/app.log
