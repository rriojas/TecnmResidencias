# ==============================================================================
# Configuración del servidor de correo SMTP para producción (.env)
# ==============================================================================
# ESTE ARCHIVO ES UNA PLANTILLA DE EJEMPLO. 
# Copia este archivo como .env en el servidor y configura tus credenciales reales.
# El archivo .env está ignorado por git para que nadie más pueda ver tus datos.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SENDER_NAME=TecNM Campus Monclova
SMTP_SENDER_EMAIL=noreply@monclova.tecnm.mx
SMTP_USERNAME=noreply@monclova.tecnm.mx
SMTP_PASSWORD=TU_CONTRASEÑA_DE_APLICACION_AQUI
SMTP_ENABLE_SSL=true
SMTP_USE_MOCK=false
